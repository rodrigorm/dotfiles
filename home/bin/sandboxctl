#!/usr/bin/env bash

set -euo pipefail

script_path="${BASH_SOURCE[0]}"
while [[ -L "$script_path" ]]; do
    script_dir="$(cd -P "$(dirname "$script_path")" && pwd)"
    script_target="$(readlink "$script_path")"
    if [[ "$script_target" == /* ]]; then
        script_path="$script_target"
    else
        script_path="$script_dir/$script_target"
    fi
done

script_dir="$(cd -P "$(dirname "$script_path")" && pwd)"
cli_source="$script_dir/../.config/opencode/sandbox/cli.ts"
if command -v bun >/dev/null 2>&1 && [[ -f "$cli_source" ]]; then
    exec bun "$cli_source" "$@"
fi
cli_bundle="$script_dir/../.config/opencode/sandbox/cli.mjs"
if command -v node >/dev/null 2>&1 && [[ -f "$cli_bundle" ]]; then
    exec node "$cli_bundle" "$@"
fi
printf 'sandboxctl: Bun source or Node bundle is unavailable\n' >&2
exit 127
